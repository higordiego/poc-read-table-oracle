							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"projection",
								"plan",
								"{{calculationId}}"
							]
						}
					}
				},
				{
					"name": "Validate projection",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/admin/projection/validate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"projection",
								"validate"
							]
						}
					}
				},
				{
					"name": "Rebuild projection (blue/green cutover)",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{baseUrl}}/api/admin/projection/rebuild",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"admin",
								"projection",
								"rebuild"
							]
						}
					}
				}
			]
		},
		{
			"name": "Reference",
			"item": [
				{
					"name": "OpenAPI spec (JSON)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/v3/api-docs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"api-docs"
							]
						}
					}
				},
				{
					"name": "Swagger UI (abrir no navegador, não no Postman)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/swagger-ui/index.html",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"swagger-ui",
								"index.html"
							]
						}
					}
				}
			]
		}
	]
}
